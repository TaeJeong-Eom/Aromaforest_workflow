      "id": "e91ae546-5079-4c3c-8c9f-bcf2b13e3f81",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "const doc = $input.first().json;\nconst raw = $('When Executed by Another Workflow').first().json.parsedData;\nconst parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst content = doc.body.content;\nconst tables = content.filter(item => item.table);\nconst requests = [];\n\n// 동적으로 '상세데이터*' 키 모두 수집\nconst tableDataList = Object.keys(parsed)\n  .filter(k => k.startsWith('상세데이터'))\n  .sort()\n  .map(k => parsed[k])\n  .filter(Boolean);\n\n// 표가 없으면 빈 요청 반환\nif (tables.length === 0) {\n  return [{ json: { fullBody: '', isEmpty: true } }];\n}\n\n// 역순 처리 (뒤 표부터 적용해야 앞 표 위치 변동 없음)\nconst tablesReversed = [...tables].reverse();\n\n// 1. 컬럼 너비 설정 (역순)\ntablesReversed.forEach((tableItem) => {\n  const tableStartIndex = tableItem.startIndex;\n  const numCols = tableItem.table.columns;\n  const widths = numCols === 2\n    ? [150, 301]\n    : Array(numCols).fill(Math.floor(451 / numCols));\n  widths.forEach((width, colIdx) => {\n    requests.push({\n      updateTableColumnProperties: {\n        tableStartLocation: { index: tableStartIndex },\n        columnIndices: [colIdx],\n        tableColumnProperties: {\n          widthType: 'FIXED_WIDTH',\n          width: { magnitude: width, unit: 'PT' }\n        },\n        fields: 'width,widthType'\n      }\n    });\n  });\n});\n\n// 2. 헤더 배경색 (역순)\ntablesReversed.forEach((tableItem, revIdx) => {\n  const originalIdx = tables.length - 1 - revIdx;\n  if (!tableDataList[originalIdx]) return;\n  \n  const tableStartIndex = tableItem.startIndex;\n  \n  requests.push({\n    updateTableCellStyle: {\n      tableRange: {\n        tableCellLocation: {\n          tableStartLocation: { index: tableStartIndex },\n          rowIndex: 0,\n          columnIndex: 0\n        },\n        rowSpan: 1,\n        columnSpan: tableItem.table.columns\n      },\n      tableCellStyle: {\n        backgroundColor: {\n          color: {\n            rgbColor: { red: 0.937, green: 0.937, blue: 0.937 }\n          }\n        }\n      },\n      fields: 'backgroundColor'\n    }\n  });\n});\n\nif (requests.length === 0) {\n  return [{ json: { fullBody: '', isEmpty: true } }];\n}\n\nconst fullBody = JSON.stringify({ requests });\nreturn [{ json: { fullBody, isEmpty: false } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        0
      ],
      "id": "86450ac4-8c69-4cec-a57c-2d45650419c5",
