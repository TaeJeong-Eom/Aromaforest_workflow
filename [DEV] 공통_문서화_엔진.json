      "id": "33c4d305-4336-4a46-8ee1-4f55aad60009",
      "name": "Docs 표 스타일 적용"
    },
    {
      "parameters": {
        "jsCode": "const doc = $input.first().json;\nconst raw = $('When Executed by Another Workflow').first().json.parsedData;\nconst parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst content = doc.body.content;\nconst tables = content.filter(item => item.table);\n\n// 동적으로 '상세데이터*' 키 모두 수집\nconst tableDataList = Object.keys(parsed)\n  .filter(k => k.startsWith('상세데이터'))\n  .sort()\n  .map(k => parsed[k])\n  .filter(Boolean);\n\n// 모든 셀 삽입 요청을 통합 배열에 수집\nconst allCellInserts = [];\n\ntables.forEach((tableItem, tableIdx) => {\n  const tableData = tableDataList[tableIdx];\n  if (!tableData) return;\n  \n  const allRows = [tableData.컬럼, ...tableData.행들];\n  const numCols = tableData.컬럼.length;\n  const tableStartIndex = tableItem.startIndex;\n  \n  allRows.forEach((row, r) => {\n    row.forEach((cellText, c) => {\n      if (!cellText) return;\n      const cellIndex = tableStartIndex + 3 + r * (numCols * 2 + 1) + c * 2;\n      allCellInserts.push({\n        insertText: {\n          text: cellText,\n          location: { index: cellIndex }\n        }\n      });\n    });\n  });\n});\n\n// index 내림차순 정렬 (뒤쪽부터 삽입)\nallCellInserts.sort((a, b) => b.insertText.location.index - a.insertText.location.index);\n\nif (allCellInserts.length === 0) {\n  return [{ json: { fullBody: '', isEmpty: true } }];\n}\n\nconst fullBody = JSON.stringify({ requests: allCellInserts });\nreturn [{ json: { fullBody, isEmpty: false } }];"
      },
