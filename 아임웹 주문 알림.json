      "id": "cb9b19bc-d0bf-475c-933a-f36792b53e8e",
      "name": "아임웹 주문 조회"
    },
    {
      "parameters": {
        "jsCode": "const allOrders = $input.first().json.data.list;\n\nconst orders = allOrders\n  .filter(order => order.complete_time === 0)\n  .slice(0, 5);\n\nif (!orders || orders.length === 0) {\n  return [{ \n    json: { \n      message: \"새 주문 없음\",\n      template_object: JSON.stringify({\n        object_type: \"text\",\n        text: \"📭 새 주문 없음\",\n        link: { web_url: \"https://aromaforest.shop\" }\n      })\n    } \n  }];\n}\n\nconst messages = orders.map(order => {\n  const date = new Date(order.order_time * 1000);\n  const timeStr = date.toLocaleString('ko-KR');\n  const price = (order.payment.total_price || 0).toLocaleString('ko-KR');\n  \n  return `🛒 주문자: ${order.orderer.name}\\n시간: ${timeStr}\\n합계: ${price}원`;\n});\n\nconst textContent = messages.join('\\n\\n');\n\nreturn [{ \n  json: { \n    message: textContent,\n    template_object: JSON.stringify({\n      object_type: \"text\",\n      text: textContent,\n      link: { web_url: \"https://aromaforest.shop\" }\n    })\n  } \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        144
      ],
