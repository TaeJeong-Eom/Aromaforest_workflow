{
  "name": "아임웹 주문 알림",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const now = new Date();\n\n// 이번 주 월요일 계산\nconst day = now.getDay();\nconst diff = day === 0 ? 6 : day - 1;\nconst monday = new Date(now);\nmonday.setDate(now.getDate() - diff);\nmonday.setHours(0, 0, 0, 0);\n\n// timestamp 변환\nconst fromTimestamp = Math.floor(monday.getTime() / 1000);\nconst toTimestamp = Math.floor(now.getTime() / 1000);\n\nreturn [{\n  json: {\n    order_date_from: fromTimestamp,\n    order_date_to: toTimestamp\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        144
      ],
      "id": "357e08c8-d2a8-494e-bbf6-e30cb97fa8a4",
      "name": "날짜 계산"
    },
    {
      "parameters": {
        "url": "https://api.imweb.me/v2/shop/orders",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "order_date_to",
              "value": "={{ $json.order_date_to }}"
            },
