    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst expiryDate = new Date(row['만료일']);\nconst today = new Date();\nconst diffTime = expiryDate - today;\nconst diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\nreturn [{\n  json: {\n    daysLeft: diffDays,\n    expiryDate: row['만료일'],\n    shouldAlert: diffDays <= 3\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        224
      ],
      "id": "69bf27ac-f34e-4192-9dd9-b5295aa21d9b",
      "name": "만료일 계산"
    },
    {
