      ],
      "id": "752136bb-1202-4e8c-903c-cb72fcb2afb6",
      "name": "Clean Output"
    },
    {
      "parameters": {
        "jsCode": "// AI 출력 정제: JSON 파싱 + 검증 + 임계값 적용\n\nconst aiOutput = $input.first().json.output || $input.first().json.text || $input.first().json;\n\nlet parsed;\n\n// JSON 파싱 (문자열일 경우)\ntry {\n  if (typeof aiOutput === 'string') {\n    // 마크다운 코드블록 제거\n    const cleaned = aiOutput.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } else {\n    parsed = aiOutput;\n  }\n} catch (e) {\n  return [{\n    json: {\n      category: 'unknown',\n      confidence: 0,\n      extracted_info: { owners: [], period: null, products: [], categories: [], extra_focus: null },\n      document_type: null,\n      reasoning: 'JSON 파싱 실패: ' + e.message,\n      raw_output: aiOutput\n    }\n  }];\n}\n\n// Confidence 임계값 적용 (0.7 미만 → unknown)\nconst CONFIDENCE_THRESHOLD = 0.7;\n\nif (parsed.confidence < CONFIDENCE_THRESHOLD && parsed.category !== 'unknown') {\n  parsed.category = 'unknown';\n  parsed.reasoning = `Confidence 낮음 (${parsed.confidence}) - unknown 처리: ` + (parsed.reasoning || '');\n}\n\n// 카테고리 검증\nconst validCategories = ['owner', 'sales', 'stock', 'unknown'];\nif (!validCategories.includes(parsed.category)) {\n  parsed.category = 'unknown';\n  parsed.reasoning = '유효하지 않은 카테고리: ' + (parsed.reasoning || '');\n}\n\n// 사용자 원본 질문 보존 (다음 노드에서 활용)\nparsed.original_query = $('When chat message received').first().json.chatInput || '';\n\nreturn [{ json: parsed }];"
      },
