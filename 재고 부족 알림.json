      "id": "0c4e67f8-805a-4889-a8c0-fb31d59bdd8d",
      "name": "상품조회"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.first().json.data.list;\n\n// 카테고리 코드\nconst CAT_FRAGRANCE = 'f20160708577ef3395a551'; // 향료\nconst CAT_BOTTLE = 's202202255681c700d7972';     // 공병\nconst CAT_BASE = 's202202257ebd48ab82b67';       // 베이스,색소\nconst CAT_ETC = 'f20160708577ef35540de9';        // 기타 부자재\n\nconst alerts = [];\n\nproducts.forEach(product => {\n  const stock = product.stock;\n  const name = product.name;\n\n  if (product.prod_status !== 'sale') return;\n  if (!stock.stock_use || stock.stock_unlimit) return;\n\n  const qty = stock.stock_no_option;\n  let threshold = null;\n  let catName = null;\n\n  product.categories.forEach(catCode => {\n\n    if (catCode === CAT_FRAGRANCE) {\n      threshold = 5;\n      catName = '향료';\n\n    } else if (catCode === CAT_BOTTLE) {\n      if (name.includes('펌프')) {\n        threshold = 50; catName = '펌프';\n      } else if (name.includes('코롱')) {\n        threshold = 20; catName = '코롱 공병';\n      } else if (name.includes('뚜껑') || name.includes('캡')) {\n        threshold = 10; catName = '뚜껑';\n      } else {\n        threshold = 10; catName = '공병';\n      }\n\n    } else if (catCode === CAT_BASE) {\n      if (name.includes('클린리퀴드')) {\n        threshold = 10; catName = '클린리퀴드';\n      }\n\n    } else if (catCode === CAT_ETC) {\n      if (name.includes('파우치')) {\n        threshold = 5; catName = '파우치';\n      }\n    }\n\n    if (threshold !== null && qty <= threshold) {\n      alerts.push({\n        name: name,\n        category: catName,\n        stock: qty,\n        threshold: threshold\n      });\n    }\n  });\n});\n\nconst messageLines = alerts.map((item, index) => {\n  return `${index + 1}. [${item.category}] ${item.name}\\n   잔여 재고: ${item.stock}개 (기준: ${item.threshold}개 이하)`;\n});\n\nconst text = alerts.length > 0\n  ? `⚠️ 재고 확인 필요 상품\\n\\n${messageLines.join('\\n\\n')}`\n  : null;\n\nreturn [{ json: { \n  hasAlerts: alerts.length > 0,\n  alerts: alerts,\n  text: text,\n  template_object: alerts.length > 0 ? JSON.stringify({\n    object_type: \"text\",\n    text: text,\n    link: { web_url: \"https://aromaforest.shop\" }\n  }) : null\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
