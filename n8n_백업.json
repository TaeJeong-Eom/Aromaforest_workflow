      ],
      "id": "4b1a41b0-4ede-4c70-a121-9d6bcfb3bef7",
      "name": "GitHub - Push",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        896,
