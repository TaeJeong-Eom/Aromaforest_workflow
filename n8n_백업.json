      ],
      "id": "4bf88ce5-75b4-47e5-8088-61dbf25a80ed",
      "name": "n8n 워크플로우 전체 조회"
    },
    {
      "parameters": {
        "jsCode": "// n8n API 응답에서 워크플로우 목록 추출\nconst response = $input.first().json;\nconst workflows = response.data || [];\n\n// 각 워크플로우를 GitHub에 올릴 형태로 변환\nconst items = workflows.map(wf => {\n  // 파일명: WF_{id}_{이름}.json 형태\n  const safeName = (wf.name || 'unnamed').replace(/[\\/\\\\:*?\"<>|]/g, '_');\n  const fileName = `workflows/${safeName}.json`;\n  \n  // JSON 내용 (pretty print)\n  const content = JSON.stringify(wf, null, 2);\n  \n  // GitHub API는 base64 인코딩 필요\n  const contentBase64 = Buffer.from(content, 'utf-8').toString('base64');\n  \n  return {\n    json: {\n      fileName,\n      contentBase64,\n      workflowName: wf.name,\n      workflowId: wf.id\n    }\n  };\n});\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "dd3dbd3d-41d4-4544-83ff-f7b42217a419",
      "name": "파일 정리"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/TaeJeong-Eom/aromaforest-automation/contents/{{ $json.fileName }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        -64
      ],
      "id": "949e5d57-94bf-4439-b4e8-a5cb637f5456",
      "name": "GitHub - 파일 존재 확인"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fileCheck = $input.item.json;\nconst fileInfo = $('파일 정리').item.json;\n\nconst body = {\n  message: `백업: ${fileInfo.workflowName} - ${new Date().toISOString().slice(0, 16).replace('T', ' ')}`,\n  content: fileInfo.contentBase64\n};\n\nif (fileCheck.sha) {\n  body.sha = fileCheck.sha;\n}\n\nreturn {\n  json: {\n    fileName: fileInfo.fileName,\n    workflowName: fileInfo.workflowName,\n    body: body\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -64
      ],
      "id": "7981eba1-5721-4768-8639-c05c7ecddfb3",
      "name": "GitHub Body 생성"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/TaeJeong-Eom/aromaforest-automation/contents/{{ $json.fileName }}",
